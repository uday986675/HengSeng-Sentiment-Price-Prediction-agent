# HengSeng Sentiment Price Prediction Agent - Environment Configuration

# Apify API Token for social media scrapers (Telegram, LIHKG, Futu/Moomoo, etc.)
# Get your token at https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_your_token_here

# Exa.com API Key for news search and retrieval
# Get your key at https://dashboard.exa.ai/
EXA_API_KEY=exa_api_key_your_key_here

# Tavily API Key (Optional fallback backend for web & social ingestion)
# Get your key at https://app.tavily.com/
TAVILY_API_KEY=tvly-your_key_here

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Caching mode (set to true to reuse downloaded raw data if available)
ENABLE_CACHE=true

# Mock mode fallback (if true or if API keys are missing/invalid, falls back gracefully to high-fidelity synthetic feed)
USE_SYNTHETIC_FALLBACK=true
